# Copy this file to ".env" and fill in your own values.
# The real .env is ignored by git, so your keys never get uploaded.

# The address alerts are sent FROM (must be verified in Brevo if you use it)
EMAIL_SENDER=your.email@gmail.com
EMAIL_SENDER_NAME=ORION-Health

# --- Option 1 (recommended): Brevo HTTP API ---
# Works on free hosting that blocks SMTP ports. Get a key at
# https://app.brevo.com -> SMTP & API -> API Keys
BREVO_API_KEY=

# --- Option 2: Gmail SMTP (local use) ---
# Gmail App Password, NOT your normal password:
# https://myaccount.google.com/apppasswords
EMAIL_PASSWORD=

# Optional SMTP overrides (defaults are Gmail)
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587

# Optional: folder for the SQLite database files (default: project root)
# DB_DIR=/data
